# Application Runtime
ENV=development
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL Database (Render postgres:// URLs auto-convert to postgresql+psycopg://)
POSTGRES_USER=cinema
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=absolute_cinema
DATABASE_URL=postgresql+psycopg://cinema:change_me_in_production@localhost:5432/absolute_cinema

# JWT & Session Security (>= 32 random chars required in production)
JWT_SECRET_KEY=replace_with_64_char_random_hex_secret_for_access_tokens
JWT_REFRESH_SECRET_KEY=replace_with_64_char_random_hex_secret_for_refresh_tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Allowed Frontend Origins (exact origin, comma-separated; never '*' in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Optional Admin Bootstrap (used once by idempotent seed if provided)
ADMIN_EMAIL=curator@absolutecinema.org
ADMIN_PASSWORD=

# Google OAuth (optional; leave empty to hide Google Sign-In button)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# TMDB API (offline ml/src/enrich.py ingestion only; never needed at web runtime)
TMDB_API_KEY=

# Frontend Build API Base (/api for same-origin nginx proxy, or full Render backend URL + /api)
VITE_API_BASE_URL=http://localhost:8000/api
